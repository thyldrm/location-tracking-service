# Copy to `.env` for local development. Real deployments inject these through the orchestrator.
# Every variable is validated at startup (src/core/config/env.schema.ts).

NODE_ENV=development
SERVICE_NAME=location-tracking-service
LOG_LEVEL=info
# json (default, one object per line) or pretty (human-readable, local development only)
LOG_FORMAT=pretty

# Comma-separated service API keys (at least 32 characters each). Several may be active during rotation.
API_KEYS=local-development-api-key-change-me-0123456789

HTTP_HOST=0.0.0.0
# HTTP_PORT is unset on purpose: the api listens on 3000 and the worker on 3001 by default.
# HTTP_PORT=3000
HTTP_BODY_LIMIT_BYTES=1048576
HTTP_TRUST_PROXY=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=location
POSTGRES_PASSWORD=location
POSTGRES_DB=location_tracking
POSTGRES_SSL=false
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000

# Maximum number of positions of one area polygon (all rings together)
AREA_MAX_VERTICES=5000
