# Copy to `.env` for local development. Real deployments inject these through the orchestrator.
# Every variable is validated at startup (src/core/config/env.schema.ts).

NODE_ENV=development
SERVICE_NAME=location-tracking-service
LOG_LEVEL=info
# json (default, one object per line) or pretty (human-readable, local development only)
LOG_FORMAT=pretty

# Comma-separated service API keys (at least 32 characters each). Several may be active during rotation.
API_KEYS=local-development-api-key-change-me-0123456789

HTTP_HOST=0.0.0.0
# HTTP_PORT is unset on purpose: the api listens on 3000 and the worker on 3001 by default.
# HTTP_PORT=3000
HTTP_BODY_LIMIT_BYTES=1048576
HTTP_TRUST_PROXY=false

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=location
POSTGRES_PASSWORD=location
POSTGRES_DB=location_tracking
POSTGRES_SSL=false
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000

# Maximum number of positions of one area polygon (all rings together)
AREA_MAX_VERTICES=5000

# Comma-separated bootstrap servers (the EXTERNAL listener of the compose broker)
KAFKA_BROKERS=localhost:9092
# A produced ping must be acknowledged within this time, otherwise POST /locations answers 503
KAFKA_DELIVERY_TIMEOUT_MS=3000
KAFKA_PRODUCER_QUEUE_MAX_MESSAGES=100000
KAFKA_LINGER_MS=5
# Replication factor of topics created by provision-topics (3 in production)
KAFKA_REPLICATION_FACTOR=1

REDIS_URL=redis://localhost:6379
REDIS_COMMAND_TIMEOUT_MS=100

# Accepted client timestamps: at most 60 s in the future, at most 24 h old
PING_MAX_FUTURE_SKEW_MS=60000
PING_MAX_AGE_MS=86400000
# Per-user rate limit for POST /locations
RATE_LIMIT_PINGS_PER_WINDOW=10
RATE_LIMIT_WINDOW_MS=10000

# Worker: Kafka consumer group and the number of partitions processed in parallel per instance
KAFKA_CONSUMER_GROUP=entry-detector
WORKER_PARTITION_CONCURRENCY=4
# Attempts for a ping failing with a non-transient error before it goes to location.pings.v1.dlq
WORKER_MAX_ATTEMPTS=3
# A gap of more than 15 min between two pings ends the previous presence (stale session)
PRESENCE_TTL_MS=900000
# Lifetime of the cached presence state in Redis (must exceed PRESENCE_TTL_MS)
PRESENCE_STATE_TTL_MS=86400000
# Full reload interval of the in-memory area index
AREA_INDEX_REFRESH_MS=60000

# Outbox relay: events per transaction, pause when idle, broker rejections before an event is parked
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_MAX_ATTEMPTS=10

# Housekeeping: run every 10 min, keep published outbox events 7 days and idempotency keys 24 h
HOUSEKEEPING_INTERVAL_MS=600000
OUTBOX_RETENTION_MS=604800000
IDEMPOTENCY_KEY_TTL_MS=86400000
